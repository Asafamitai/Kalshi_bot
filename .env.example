# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# In a Claude Code cloud environment, set these as environment variables instead.

# Kalshi: only needed for buying. Scanning uses public market data.
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2   # demo: https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_KEY_ID=
# Either the PEM itself (\n for newlines is fine) or a path to it.
KALSHI_PRIVATE_KEY=
KALSHI_PRIVATE_KEY_PATH=

# Telegram: a bot from @BotFather, and your chat id (`python -m kalshi_bot telegram-chats`).
KALSHI_LADDER_BOT_TOKEN=
KALSHI_LADDER_BOT_CHAT_ID=
# Who may press buy buttons and send commands (comma-separated user ids). Defaults to KALSHI_LADDER_BOT_CHAT_ID.
# KALSHI_LADDER_BOT_ALLOWED_USER_IDS=

SCAN_INTERVAL_SECONDS=300
# Tracked: contradictions of at least this much against the dominated rung's mid...
MIN_SAVING=0.01
# ...when that rung's book is two-sided and no wider than this.
MAX_SPREAD=0.10
# Alerted: only those that also pass these.
MIN_NET_SAVING=0.01
MIN_PRICE=0.30
MAX_PRICE=0.90
MIN_DEPTH=50
MIN_VOLUME_24H=50
COOLDOWN_HOURS=12
MAX_ALERTS_PER_PASS=10
# Buy buttons, plus "all the depth".
BUY_SIZES=10,50
# Paper trading: two books (safer contract alone vs locked pair), no keys or money needed.
PAPER_TRADING=on
PAPER_BANKROLL=500
PAPER_MAX_TRADE=15
PAPER_TAKE_PROFIT=0.80
# The single book's own filters, looser than the alerts' (net saving is shared).
PAPER_MIN_PRICE=0.10
PAPER_MAX_PRICE=0.95
PAPER_MIN_DEPTH=10
PAPER_MIN_VOLUME_24H=0
# Paper trading's own Telegram bot (optional): a second bot from @BotFather and your chat with it
# (`python -m kalshi_bot telegram-chats --paper`). Without it, paper trading runs silently.
KALSHI_LADDER_AUTO_BOT_TOKEN=
KALSHI_LADDER_AUTO_BOT_CHAT_ID=
# KALSHI_LADDER_AUTO_BOT_ALLOWED_USER_IDS=
DB_PATH=kalshi_bot.sqlite3
