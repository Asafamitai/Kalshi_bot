# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# In a Claude Code cloud environment, set these as environment variables instead.

# Kalshi: only needed for buying. Scanning uses public market data.
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2   # demo: https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_KEY_ID=
# Either the PEM itself (\n for newlines is fine) or a path to it.
KALSHI_PRIVATE_KEY=
KALSHI_PRIVATE_KEY_PATH=

# Telegram: a bot from @BotFather, and your chat id (`python -m kalshi_bot telegram-chats`).
KALSHI_LADDER_BOT_TOKEN=
KALSHI_LADDER_BOT_CHAT_ID=
# Who may press buy buttons and send commands (comma-separated user ids). Defaults to KALSHI_LADDER_BOT_CHAT_ID.
# KALSHI_LADDER_BOT_ALLOWED_USER_IDS=

SCAN_INTERVAL_SECONDS=300
# Tracked: contradictions of at least this much against the dominated rung's mid...
MIN_SAVING=0.01
# ...when that rung's book is two-sided and no wider than this.
MAX_SPREAD=0.10
# Alerted: only those that also pass these.
MIN_NET_SAVING=0.01
MIN_PRICE=0.30
MAX_PRICE=0.90
MIN_DEPTH=50
MIN_VOLUME_24H=50
# Contracts the dominated (reference) rung traded in a day; its mid is what the saving is measured against.
MIN_REF_VOLUME_24H=20
# Skip markets that stop trading or resolve within this many hours (live games); 0 turns it off.
MIN_HOURS_LEFT=24
COOLDOWN_HOURS=12
MAX_ALERTS_PER_PASS=10
# Buy buttons, plus "all the depth".
BUY_SIZES=10,50
# Paper trading: three books (safer contract alone, the same with strict filters, locked pair), no keys or money needed.
PAPER_TRADING=on
PAPER_BANKROLL=500
PAPER_MAX_TRADE=15
PAPER_TAKE_PROFIT=0.80
# The single book's own filters, looser than the alerts' (net saving is shared).
PAPER_MIN_PRICE=0.10
PAPER_MAX_PRICE=0.95
PAPER_MIN_DEPTH=10
PAPER_MIN_VOLUME_24H=0
# The strict book: the alert filters, plus at most this spread on the contract bought.
PAPER_STRICT_MAX_SPREAD=0.05
# The books that open new trades (single, strict, pair); the rest only see out what they hold.
PAPER_BOOKS=strict,pair
# Automatic trading with real money on the strict strategy: off until /auto on in Telegram.
# Dollars per trade (fees included), and the most it may lose in all.
LIVE_MAX_TRADE=10
LIVE_BUDGET=100
# The Kalshi subaccount it trades in. Unset: the one `/subaccount create` opened
# (KALSHI_LADDER_AUTO_BOT), else the primary account. 0 forces the primary account, 1-63 a subaccount.
# KALSHI_LADDER_AUTO_BOT_SUBACCOUNT=
# KALSHI_LADDER_AUTO_BOT: the Telegram bot for automatic trading (/auto, /live, /status, /subaccount)
# and paper trading (/paper); a second bot from @BotFather and your chat with it
# (`python -m kalshi_bot telegram-chats --paper`). Without it, automatic trading can't be switched on
# and paper trading runs silently.
KALSHI_LADDER_AUTO_BOT_TOKEN=
KALSHI_LADDER_AUTO_BOT_CHAT_ID=
# KALSHI_LADDER_AUTO_BOT_ALLOWED_USER_IDS=
DB_PATH=kalshi_bot.sqlite3
