# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Kalshi: only needed for buying. Scanning uses public market data.
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2   # demo: https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_KEY_ID=
# Either the PEM itself (\n for newlines is fine) or a path to it.
KALSHI_PRIVATE_KEY=
KALSHI_PRIVATE_KEY_PATH=

# Telegram: a bot from @BotFather, and your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Who may press buy buttons (comma-separated user ids). Defaults to TELEGRAM_CHAT_ID.
# TELEGRAM_ALLOWED_USER_IDS=

SCAN_INTERVAL_SECONDS=300
# Smallest saving worth an alert, in dollars, against the dominated rung's mid.
MIN_SAVING=0.02
# The dominated rung's book must be two-sided and no wider than this for its
# mid to count as a price (a 0.01/0.99 placeholder quote has a meaningless mid).
MAX_SPREAD=0.10
# Dollars spent per tap: contracts = floor(budget / ask).
BUY_BUDGET_USD=10
# Off by default: taps only report what they would buy. Set to 1 to place real orders.
LIVE_TRADING=0
DB_PATH=kalshi_bot.sqlite3
